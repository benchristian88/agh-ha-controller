[Unit]
Description=AGH HA Controller
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=aghha
Group=aghha
EnvironmentFile=/etc/agh-ha-controller/agh-ha-controller.env
ExecStart=/usr/local/bin/agh-ha-controller
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/agh-ha-controller

[Install]
WantedBy=multi-user.target
