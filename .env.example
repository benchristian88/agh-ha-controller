# Copy to .env for Docker Compose. Use URL-safe characters for the database
# password because it is interpolated into DATABASE_URL.
POSTGRES_DB=atlas_dns
POSTGRES_USER=atlas_dns
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24
PUBLIC_BASE_URL=http://controller-host:8080
ATLAS_DNS_VERSION=1.0.1
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-base64-output
# Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-output
LOG_LEVEL=info
SESSION_DURATION=12h
NODE_HEALTH_INTERVAL=30s
NODE_REQUEST_TIMEOUT=10s
STATISTICS_POLL_INTERVAL=1h
QUERY_LOG_COLLECTION_ENABLED=true
QUERY_LOG_POLL_INTERVAL=30s
QUERY_LOG_RETENTION=168h
# Optional. Generate with `openssl rand -hex 32`; when set, enables /metrics.
METRICS_BEARER_TOKEN=
ATLAS_DNS_BIND_ADDRESS=0.0.0.0
ATLAS_DNS_PORT=8080
