# Production-style template. For the committed disposable Release 0.1
# environment, run `make test-env-up` and source scripts/local-test-env.sh.
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://aghha:aghha@localhost:5432/aghha?sslmode=disable
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-base64-output
# Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-output
PUBLIC_BASE_URL=http://localhost:8080
LOG_LEVEL=info
SESSION_DURATION=12h
NODE_HEALTH_INTERVAL=30s
NODE_REQUEST_TIMEOUT=10s
AUTO_MIGRATE=true
WEB_DIST_DIR=web/dist
